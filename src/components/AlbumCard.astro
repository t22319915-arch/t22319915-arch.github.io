---
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  href: string;
  date: Date;
  cover?: string;
  photoCount: number;
}

const { title, href, date, cover, photoCount } = Astro.props;
---

<article class="group overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-sand-200 transition-shadow hover:shadow-lg">
  <a href={href} class="block">
    <div class="relative aspect-[4/3] w-full overflow-hidden bg-sand-100">
      {cover ? (
        <img
          src={cover}
          alt={title}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-navy-700 to-navy-900">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.6-4.6a2 2 0 0 1 2.8 0L16 16m-2-2l1.6-1.6a2 2 0 0 1 2.8 0L20 14M6 20h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z" />
          </svg>
        </div>
      )}
      <span class="absolute bottom-3 right-3 rounded-full bg-navy-950/70 px-3 py-1 text-xs font-bold text-white backdrop-blur">
        {photoCount} 張照片
      </span>
    </div>
    <div class="p-5">
      <time datetime={date.toISOString()} class="text-sm text-neutral-500">
        {formatDate(date)}
      </time>
      <h3 class="mt-1 line-clamp-2 font-bold leading-7 text-navy-900 group-hover:text-brick-700 group-hover:underline group-hover:underline-offset-4">
        {title}
      </h3>
    </div>
  </a>
</article>
