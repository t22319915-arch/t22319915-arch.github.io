---
import { formatDate, categoryLabel } from '../utils/date';

export interface AnnouncementItem {
  title: string;
  href: string;
  date: Date;
  category: string;
}

interface Props {
  items: AnnouncementItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-label="最新公告" class="border-b border-brick-100 bg-brick-50">
      <div class="mx-auto max-w-6xl px-4 py-5 sm:px-6">
        <div class="flex items-center gap-2 text-brick-700">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5.5h8M11 5.5a2.5 2.5 0 1 0-4.9.7M11 5.5V4m-4.9 2.2A2.5 2.5 0 1 0 8.6 8.7M4 11h16a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-6l-3 3v-3H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1z" />
          </svg>
          <h2 class="font-bold">最新公告</h2>
        </div>
        <ul class="mt-3 space-y-2">
          {items.map((item) => (
            <li>
              <a href={item.href} class="group flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-lg px-2 py-1.5 transition-colors hover:bg-white">
                <span class="inline-block shrink-0 rounded bg-brick-600 px-2 py-0.5 text-xs font-bold text-white">
                  {categoryLabel(item.category)}
                </span>
                <span class="min-w-0 flex-1 font-medium text-neutral-800 group-hover:text-brick-700 group-hover:underline group-hover:underline-offset-4">
                  {item.title}
                </span>
                <time datetime={item.date.toISOString()} class="shrink-0 text-sm text-neutral-500">
                  {formatDate(item.date)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
