---
import { Image } from 'astro:assets';
import { site, NAV_LINKS } from '../data/site';
import logoImg from '../assets/logo.png';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-sand-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex min-w-0 items-center gap-3">
      <Image
        src={logoImg}
        alt={`${site.churchName} Logo`}
        width={44}
        height={44}
        class="h-11 w-11 shrink-0 rounded-full bg-white object-cover ring-1 ring-sand-200"
      />
      <span class="truncate text-lg font-bold tracking-wide text-navy-800">
        {site.churchName}
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="主選單">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-4 py-2 text-[15px] font-medium transition-colors',
              isActive(link.href)
                ? 'bg-navy-700 text-white'
                : 'text-neutral-700 hover:bg-sand-100 hover:text-navy-800',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <button
      id="menu-button"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-navy-800 hover:bg-sand-100 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="開啟選單"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-sand-200 bg-white px-4 py-2 md:hidden" aria-label="行動版選單">
    {
      NAV_LINKS.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'block rounded-lg px-4 py-3 text-base font-medium',
            isActive(link.href)
              ? 'bg-navy-700 text-white'
              : 'text-neutral-700 hover:bg-sand-100',
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  button?.addEventListener('click', () => {
    const expanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!expanded));
    button.setAttribute('aria-label', expanded ? '開啟選單' : '關閉選單');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
