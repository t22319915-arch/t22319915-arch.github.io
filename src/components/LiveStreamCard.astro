---
import { toEmbedUrl, toWatchUrl } from '../utils/youtube';
import { formatDate } from '../utils/date';

export interface LiveStreamData {
  title: string;
  date: Date;
  youtubeUrl: string;
  description?: string;
}

interface Props {
  stream?: LiveStreamData | null;
  compact?: boolean;
}

const { stream = null, compact = false } = Astro.props;
const embedUrl = stream ? toEmbedUrl(stream.youtubeUrl) : null;
const watchUrl = stream ? toWatchUrl(stream.youtubeUrl) : null;
---

{
  stream && embedUrl ? (
    <div class="overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-sand-200">
      <div class="aspect-video w-full bg-navy-950">
        <iframe
          src={embedUrl}
          title={stream.title}
          class="h-full w-full"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        />
      </div>
      {!compact && (
        <div class="p-5 sm:p-6">
          <div class="flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-brick-600 px-3 py-1 text-xs font-bold text-white">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white opacity-75" />
                <span class="relative inline-flex h-2 w-2 rounded-full bg-white" />
              </span>
              本週直播
            </span>
            <time datetime={stream.date.toISOString()} class="text-sm text-neutral-500">
              {formatDate(stream.date)}
            </time>
          </div>
          <h3 class="mt-3 text-xl font-bold text-navy-900">{stream.title}</h3>
          {stream.description && <p class="mt-2 leading-7 text-neutral-600">{stream.description}</p>}
          {watchUrl && (
            <a
              href={watchUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-2 rounded-xl bg-navy-700 px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-navy-600"
            >
              前往 YouTube 觀看
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
        </div>
      )}
    </div>
  ) : (
    <div class="rounded-2xl bg-white p-8 text-center shadow-md ring-1 ring-sand-200 sm:p-12">
      <p class="text-lg font-bold text-navy-800">本週直播連結更新中</p>
      <p class="mt-2 text-neutral-500">請稍後再回來，或關注教會 Facebook 粉絲專頁取得最新消息。</p>
    </div>
  )
}
