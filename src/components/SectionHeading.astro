---
interface Props {
  kicker?: string;
  title: string;
  description?: string;
  linkHref?: string;
  linkLabel?: string;
}

const { kicker, title, description, linkHref, linkLabel } = Astro.props;
---

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    {kicker && (
      <p class="mb-2 text-sm font-bold tracking-[0.2em] text-brick-600">{kicker}</p>
    )}
    <h2 class="text-2xl font-bold text-navy-900 sm:text-3xl">{title}</h2>
    {description && <p class="mt-2 max-w-2xl text-neutral-600">{description}</p>}
  </div>
  {linkHref && linkLabel && (
    <a
      href={linkHref}
      class="inline-flex items-center gap-1 rounded-lg border border-navy-200 px-4 py-2 text-sm font-medium text-navy-700 transition-colors hover:border-navy-600 hover:bg-navy-700 hover:text-white"
    >
      {linkLabel}
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  )}
</div>
