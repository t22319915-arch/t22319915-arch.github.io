---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EventCard from '../../components/EventCard.astro';
import { site } from '../../data/site';

const slugOf = (id: string) => id.replace(/\.md$/, '');
const items = (await getCollection('announcements', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date,
);
---

<Layout title="最新消息" description={`${site.churchName}最新公告事項與活動訊息。`}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <p class="text-sm font-bold tracking-[0.2em] text-sand-300">NEWS & EVENTS</p>
      <h1 class="mt-2 text-3xl font-black text-white sm:text-4xl">最新消息</h1>
      <p class="mt-3 text-navy-100">公告事項與活動訊息，可依分類篩選。</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="mb-8 flex flex-wrap gap-2" role="group" aria-label="分類篩選">
      <button type="button" data-filter="all" class="filter-btn rounded-full bg-navy-700 px-5 py-2 text-sm font-bold text-white">全部</button>
      <button type="button" data-filter="announcement" class="filter-btn rounded-full bg-white px-5 py-2 text-sm font-bold text-navy-700 ring-1 ring-navy-200 hover:bg-sand-100">公告事項</button>
      <button type="button" data-filter="event" class="filter-btn rounded-full bg-white px-5 py-2 text-sm font-bold text-navy-700 ring-1 ring-navy-200 hover:bg-sand-100">活動訊息</button>
    </div>

    {
      items.length > 0 ? (
        <>
          <p id="result-count" class="mb-4 text-sm text-neutral-500" aria-live="polite" />
          <div id="news-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((a) => (
              <div data-cat={a.data.category}>
                <EventCard
                  title={a.data.title}
                  href={`/announcements/${slugOf(a.id)}`}
                  date={a.data.date}
                  category={a.data.category}
                  description={a.data.description}
                  image={a.data.image}
                />
              </div>
            ))}
          </div>
        </>
      ) : (
        <p class="rounded-2xl bg-white p-8 text-center text-neutral-500 shadow-md ring-1 ring-sand-200">
          目前沒有最新消息，敬請期待。
        </p>
      )
    }
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('#news-grid [data-cat]');
  const count = document.getElementById('result-count');

  const ACTIVE = ['bg-navy-700', 'text-white'];
  const IDLE = ['bg-white', 'text-navy-700'];

  function apply(filter: string) {
    let visible = 0;
    cards.forEach((card) => {
      const show = filter === 'all' || card.dataset.cat === filter;
      card.classList.toggle('hidden', !show);
      if (show) visible += 1;
    });
    if (count) count.textContent = `共 ${visible} 則`;
    buttons.forEach((btn) => {
      const on = btn.dataset.filter === filter;
      btn.classList.remove(...(on ? IDLE : ACTIVE));
      btn.classList.add(...(on ? ACTIVE : IDLE));
    });
  }

  buttons.forEach((btn) => btn.addEventListener('click', () => apply(btn.dataset.filter ?? 'all')));
  apply('all');
</script>
