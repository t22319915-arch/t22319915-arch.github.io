---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { formatDate } from '../../utils/date';
import { site } from '../../data/site';

const items = (await getCollection('bulletins', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date,
);
---

<Layout title="主日週報" description={`${site.churchName}主日週報下載。`}>
  <section class="bg-navy-900">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <p class="text-sm font-bold tracking-[0.2em] text-sand-300">BULLETIN</p>
      <h1 class="mt-2 text-3xl font-black text-white sm:text-4xl">主日週報</h1>
      <p class="mt-3 text-navy-100">每週主日週報 PDF，點選即可線上閱讀或下載。</p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
    {
      items.length > 0 ? (
        <ul class="space-y-4">
          {items.map((item) => (
            <li class="flex flex-col gap-3 rounded-2xl bg-white p-5 shadow-md ring-1 ring-sand-200 sm:flex-row sm:items-center sm:justify-between sm:p-6">
              <div class="min-w-0">
                <p class="text-sm text-neutral-500">
                  <time datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time>
                </p>
                <h2 class="mt-1 truncate text-lg font-bold text-navy-900">{item.data.title}</h2>
              </div>
              <a
                href={item.data.pdf}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-navy-700 px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-navy-600"
              >
                閱讀 / 下載
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="rounded-2xl bg-white p-8 text-center text-neutral-500 shadow-md ring-1 ring-sand-200">
          週報準備中，敬請期待。
        </p>
      )
    }
  </section>
</Layout>
